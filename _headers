/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Permissions-Policy: interest-cohort=()
  Referrer-Policy: no-referrer
  X-XSS-Protection: 0
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' blob:; script-src 'self' https://cdnjs.buymeacoffee.com https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://avatars.githubusercontent.com https://cdn.buymeacoffee.com data: blob:; connect-src 'self' https://api.github.com https://avatars.githubusercontent.com https://*.buymeacoffee.com; frame-src https://*.buymeacoffee.com; form-action 'none'; base-uri 'self';

/css/styles.css
  Cache-Control: public, max-age=2592000, immutable

/js/app.js
  Cache-Control: public, max-age=2592000, immutable

/lib/html2canvas.min.js
  Cache-Control: public, max-age=31536000, immutable

/assets/social-og.png
  Cache-Control: public, max-age=2592000

/assets/branding-default.png
  Cache-Control: public, max-age=2592000

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain
